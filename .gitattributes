# Enforce LF line endings for all text files
* text=auto eol=lf

# Force LF for scripts and source files
*.py text eol=lf
*.sh text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.json text eol=lf
*.cfg text eol=lf
*.ini text eol=lf
*.env text eol=lf

# Binaries — no line-ending conversion
*.zip binary
*.pyc binary
*.png binary
*.jpg binary
*.pdf binary
