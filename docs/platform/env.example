# Nyuydine Platform (Phase 1) — copy to .env and merge with existing keys
# Developer copy: ../../.env.platform.example (repo root)

# --- API ---
PLATFORM_API_HOST=0.0.0.0
PLATFORM_API_PORT=8080
# Optional: require X-API-Key header on /api/v1/* routes
PLATFORM_API_KEY=dev-api-key

# --- Database ---
# SQLite for local dev:
DATABASE_URL=sqlite:///./platform_data/nyuydine.db
# PostgreSQL for production:
# DATABASE_URL=postgresql://nyuydine:nyuydine@localhost:5432/nyuydine

# --- Redis / Celery ---
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
# Run repairs in-process (no worker) for local dev:
CELERY_TASK_ALWAYS_EAGER=true

# --- GitHub App ---
GITHUB_APP_ID=
# PEM contents (use \n for newlines in .env) or set GITHUB_APP_PRIVATE_KEY_PATH
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_PRIVATE_KEY_PATH=
GITHUB_WEBHOOK_SECRET=

# --- Repair worker ---
PLATFORM_WORKSPACE_ROOT=platform_data/workspaces
DEFAULT_AUTOMATION_MODE=suggest

# --- LLM (shared platform key until per-org keys in Phase 2) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
