# Copy to .env and fill in values:
#   cp .env.example .env

# --- Required (live repair mode) ---
GITHUB_TOKEN=ghp_your_token_here
GITHUB_OWNER=your-github-username
GITHUB_REPO=your-repo-name
OPENAI_API_KEY=sk-your-key-here

# --- Optional ---
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT=60
OPENAI_MAX_RETRIES=3
MAX_RETRY_ATTEMPTS=3
MAX_FAILED_RUNS=5
MAX_FAILURES_PER_RUN=10
STOP_ON_FIRST_SUCCESS=true
SAMPLE_PROJECTS_DIR=sample_projects
DOCKER_IMAGE_TAG=self-healing-validator
DOCKER_CLEANUP=true
VALIDATE_FULL_REPO=false
LOG_LEVEL=INFO

# --- Safety (recommended for first runs) ---
# Diagnose and generate patches without writing files or running Docker
DRY_RUN=false

# Backup target files before patching; restore on failed validation
BACKUP_BEFORE_PATCH=true

# --- Product safety ---
REQUIRE_APPROVAL=true
AUTO_APPROVE_PATCHES=false
APPROVAL_DIFF_MAX_LINES=80
ALLOWED_PATH_PREFIXES=sample_projects/
EXCLUDED_WORKFLOW_NAMES=Self-Heal on Failure,self-heal
GITHUB_API_MAX_RETRIES=5
OFFLINE_MODE=false

# --- Git integration (optional) ---
# Commit repairs to a branch and open a pull request
GIT_ENABLED=false
GIT_CREATE_PR=true
GIT_BRANCH_PREFIX=self-heal
GIT_BASE_BRANCH=main
GIT_PUSH_REMOTE=origin
GIT_AUTHOR_NAME=Self-Healing Bot
GIT_AUTHOR_EMAIL=self-healing-bot@users.noreply.github.com

# --- Logging ---
# Chars of patch preview at DEBUG (0 = omit entirely at INFO/DEBUG summary)
LOG_PATCH_PREVIEW_CHARS=0
